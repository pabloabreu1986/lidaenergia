---
import Icon from './Icon.astro';
import { telHref, waHref } from '../data/site';
---
<div class="callbar" role="region" aria-label="Contacto rápido">
  <a class="callbar__btn callbar__btn--tel" href={telHref} data-ubicacion="barra-movil">
    <Icon name="phone" /> Llamar ahora
  </a>
  <a class="callbar__btn callbar__btn--wa" href={waHref()} data-ubicacion="barra-movil" rel="noopener" target="_blank">
    <Icon name="whatsapp" /> WhatsApp
  </a>
</div>

<style>
  .callbar {
    position: fixed; inset: auto 0 0 0; z-index: 60;
    display: grid; grid-template-columns: 1.4fr 1fr; gap: 0.5rem;
    padding: 0.5rem 0.75rem calc(0.5rem + env(safe-area-inset-bottom));
    background: var(--blanco); border-top: 1px solid var(--linea);
    box-shadow: 0 -4px 16px rgb(23 35 46 / 0.08);
  }
  .callbar__btn {
    display: flex; align-items: center; justify-content: center; gap: 0.5rem;
    min-height: 48px; border-radius: var(--r-control);
    font-weight: 700; text-decoration: none;
  }
  .callbar__btn :global(svg) { width: 1.25rem; height: 1.25rem; }
  .callbar__btn--tel { background: var(--sol); color: var(--pizarra); }
  .callbar__btn--wa { background: var(--pizarra); color: var(--blanco); }
  .callbar__btn--tel:hover { background: var(--sol-hover); color: var(--pizarra); }
  .callbar__btn--wa:hover { background: #24394a; color: var(--blanco); }
  @media (min-width: 48rem) { .callbar { display: none; } }
</style>
