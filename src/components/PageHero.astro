---
// Cabecera editorial de páginas interiores: eyebrow, H1, subtítulo, máximo dos acciones y foto.
import { Image } from 'astro:assets';
import Button from './ui/Button.astro';
import { SITE, telHref, waHref } from '../data/site';
interface Props { eyebrow: string; title: string; lead: string; image: ImageMetadata; alt: string; ubicacion?: string }
const { eyebrow, title, lead, image, alt, ubicacion = 'cabecera-pagina' } = Astro.props;
---
<section class="ph">
  <div class="wrap ph__grid">
    <div class="ph__text">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="subtitle">{lead}</p>
      <div class="ph__btns">
        <Button href={telHref} icon="phone" ubicacion={ubicacion}>Llamar al {SITE.phoneDisplay}</Button>
        <Button href={waHref()} variant="outline" icon="whatsapp" ubicacion={ubicacion} external>WhatsApp</Button>
      </div>
      <p class="ph__proof"><a href={SITE.googleMaps} rel="noopener" target="_blank">{SITE.rating} ★ · {SITE.reviewCount} reseñas en Google</a></p>
    </div>
    <div class="ph__media">
      <Image src={image} alt={alt} width={1100} height={825} fit="cover" widths={[400, 640, 800, 1100]} sizes="(min-width: 64rem) 42vw, 100vw" loading="eager" fetchpriority="high" quality={58} />
    </div>
  </div>
</section>

<style>
  .ph { padding-block: clamp(2.5rem, 1.5rem + 4vw, 6rem) clamp(3rem, 2rem + 4vw, 6rem); }
  .ph__grid { display: grid; gap: clamp(2rem, 4vw, 4rem); align-items: end; }
  .ph__text h1 { max-width: 15ch; }
  .ph__btns { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 2rem 0 1.25rem; }
  .ph__proof { margin: 0; font-size: 0.95rem; font-weight: 560; }
  .ph__proof a { color: var(--pizarra); }
  .ph__media :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--r-media); }
  @media (min-width: 64rem) {
    .ph__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  }
</style>
