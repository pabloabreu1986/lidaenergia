---
// Una reseña destacada y dos de apoyo. Textos y autores literales de REVIEWS (site.ts).
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { REVIEWS, SITE } from '../data/site';
interface Props { eyebrow?: string; title?: string }
const { eyebrow = 'Clientes de LIDA', title = 'Así cuentan su experiencia.' } = Astro.props;
const [main, ...rest] = REVIEWS;
---
<section class="section surface-white rv" aria-labelledby="resenas-h">
  <div class="wrap">
    <div class="rv__head">
      <SectionHeading eyebrow={eyebrow} title={title} id="resenas-h" />
      <a class="rv__score" href={SITE.googleMaps} rel="noopener" target="_blank">
        <span class="rv__num">{SITE.rating}</span>
        <span class="rv__meta">
          <span class="rv__stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" />)}</span>
          <span>{SITE.reviewCount} reseñas en Google</span>
        </span>
      </a>
    </div>

    <figure class="rv__main">
      <blockquote><p>“{main.text}”</p></blockquote>
      <figcaption>{main.author}, reseña en Google</figcaption>
    </figure>

    <ul class="rv__list">
      {rest.map((r) => (
        <li>
          <figure>
            <blockquote><p>“{r.text}”</p></blockquote>
            <figcaption>{r.author}, reseña en Google</figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <p class="rv__more"><a href={SITE.googleMaps} rel="noopener" target="_blank">Leer las {SITE.reviewCount} reseñas en Google Maps</a></p>
  </div>
</section>

<style>
  .rv__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: clamp(2.5rem, 5vw, 4.5rem); }
  .rv__score { display: flex; align-items: center; gap: 0.9rem; color: var(--pizarra); text-decoration: none; }
  .rv__score:hover .rv__meta span:last-child { text-decoration: underline; }
  .rv__num { font-size: clamp(3rem, 2.4rem + 2vw, 4.25rem); font-weight: 650; letter-spacing: -0.04em; line-height: 1; }
  .rv__meta { display: grid; gap: 0.2rem; font-size: 0.95rem; color: var(--pizarra-2); }
  .rv__stars { display: flex; color: var(--sol-tinta); }
  .rv__stars :global(svg) { width: 1.15rem; height: 1.15rem; }
  figure { margin: 0; }
  blockquote { margin: 0; }
  .rv__main { max-width: 60rem; padding-bottom: clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--linea); }
  .rv__main p { font-size: clamp(1.45rem, 1.1rem + 1.5vw, 2.4rem); line-height: 1.3; letter-spacing: -0.02em; font-weight: 520; margin-bottom: 1.25rem; text-wrap: pretty; }
  figcaption { font-size: 0.95rem; font-weight: 600; color: var(--pizarra-2); }
  .rv__list { list-style: none; padding: 0; margin: clamp(2rem, 4vw, 3rem) 0 2rem; display: grid; gap: 2rem 4rem; }
  .rv__list li { margin: 0; }
  .rv__list p { font-size: 1.0625rem; color: var(--pizarra); margin-bottom: 0.75rem; }
  .rv__more { margin: 0; }
  @media (min-width: 48rem) { .rv__list { grid-template-columns: 1fr 1fr; } }
</style>
