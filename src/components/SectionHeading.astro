---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'start' | 'center';
  level?: 'h1' | 'h2';
  id?: string;
  size?: 'display' | 'default';
  class?: string;
}
const { eyebrow, title, description, align = 'start', level = 'h2', id, size = 'default', class: cls } = Astro.props;
const Tag = level;
---
<div class:list={['sh', `sh--${align}`, cls]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag id={id} class:list={[size === 'display' && 'display']}>{title}</Tag>
  {description && <p class="subtitle">{description}</p>}
  <slot />
</div>

<style>
  .sh { max-width: 52rem; }
  .sh--center { margin-inline: auto; text-align: center; }
  .sh--center .subtitle { margin-inline: auto; }
</style>
