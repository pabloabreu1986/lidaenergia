---
// Port a Astro del Button de shadcn/ui (MIT, (c) 2023 shadcn). Estilos en src/styles/ui.css.
// Renderiza <a> si recibe href (equivalente a asChild con un enlace) o <button> en otro caso.
import Icon from '../Icon.astro';
type Variant = 'default' | 'secondary' | 'outline' | 'ghost' | 'link';
type Size = 'sm' | 'default' | 'lg' | 'icon';
interface Props {
  href?: string;
  variant?: Variant;
  size?: Size;
  icon?: 'phone' | 'whatsapp';
  ubicacion?: string;
  external?: boolean;
  class?: string;
  type?: 'button' | 'submit';
  [key: string]: unknown;
}
const { href, variant = 'default', size = 'default', icon, ubicacion, external, class: cls, type = 'button', ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, size !== 'default' && `btn--${size}`, cls].filter(Boolean).join(' ');
---
{href ? (
  <a class={classes} href={href} data-slot="button" data-ubicacion={ubicacion} rel={external ? 'noopener' : undefined} target={external ? '_blank' : undefined} {...rest}>
    {icon && <Icon name={icon} />}<slot />
  </a>
) : (
  <button class={classes} type={type} data-slot="button" {...rest}>
    {icon && <Icon name={icon} />}<slot />
  </button>
)}
