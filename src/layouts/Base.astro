---
import '../styles/global.css';
import '../styles/ui.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallBar from '../components/CallBar.astro';
import { SITE } from '../data/site';
import ogDefault from '../assets/obras/azotea-placas-atardecer.jpg';
import { getImage } from 'astro:assets';

interface Crumb { name: string; href: string }
interface Props {
  title: string;
  description: string;
  breadcrumbs?: Crumb[];
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  ogImage?: ImageMetadata;
}

const { title, description, breadcrumbs = [], schema = [], noindex = false, ogImage = ogDefault } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const og = await getImage({ src: ogImage, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const ogUrl = new URL(og.src, SITE.url).href;
const brandImg = await getImage({ src: ogDefault, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const brandImgUrl = new URL(brandImg.src, SITE.url).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${SITE.url}/#empresa`,
  name: SITE.name,
  legalName: SITE.legalName,
  url: `${SITE.url}/`,
  telephone: SITE.phone,
  email: SITE.email,
  logo: `${SITE.url}/icono-512.png`,
  image: brandImgUrl,
  address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressRegion: 'Comunidad de Madrid', addressCountry: 'ES' },
  description: 'Instalación de placas solares, baterías, cargadores de coche eléctrico y mantenimiento de instalaciones fotovoltaicas en Madrid.',
  areaServed: SITE.areaServed.map((name) => ({ '@type': 'AdministrativeArea', name })),
  hasMap: SITE.googleMaps,
  sameAs: [SITE.instagram, SITE.googleMaps],
  founder: { '@type': 'Person', name: SITE.founder, sameAs: SITE.linkedinFounder },
  knowsAbout: ['Autoconsumo fotovoltaico', 'Placas solares', 'Baterías solares', 'Cargadores de vehículo eléctrico'],
};

const crumbs = breadcrumbs.length
  ? [{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Inicio', href: '/' }, ...breadcrumbs].map((c, i) => ({
        '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, SITE.url).href,
      })),
    }]
  : [];

const jsonld = [business, ...crumbs, ...schema];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#17232e" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <CallBar />
    <script>
      // Medición de clics en llamar / WhatsApp (se envía a GA4 si se instala gtag o GTM).
      document.addEventListener('click', (e) => {
        const a = (e.target as Element).closest('a');
        if (!a) return;
        const href = a.getAttribute('href') || '';
        const type = href.startsWith('tel:') ? 'click_llamar' : href.includes('wa.me/') ? 'click_whatsapp' : '';
        if (!type) return;
        const w = window as any;
        w.dataLayer = w.dataLayer || [];
        w.dataLayer.push({ event: type, ubicacion: a.dataset.ubicacion || 'otro' });
        if (typeof w.gtag === 'function') w.gtag('event', type, { ubicacion: a.dataset.ubicacion || 'otro' });
      });
    </script>
  </body>
</html>
