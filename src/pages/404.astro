---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import { FOOTER_LINKS, SITE, telHref } from '../data/site';
---
<Base title="Página no encontrada | LIDA Energía" description="La página que buscas no existe." noindex>
  <section class="section">
    <div class="wrap simple">
      <p class="eyebrow">Error 404</p>
      <h1>No encontramos esta página.</h1>
      <p class="subtitle">Puede que la dirección haya cambiado. Estas son las secciones de la web:</p>
      <ul class="simple__list">
        <li><a href="/">Inicio</a></li>
        {FOOTER_LINKS.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
      <Button href={telHref} icon="phone" ubicacion="404">Llamar al {SITE.phoneDisplay}</Button>
    </div>
  </section>
</Base>

<style>
  .simple h1 { max-width: 16ch; }
  .simple__list { margin: 1.5rem 0 2rem; padding-left: 1.2rem; }
  .simple__list a { display: inline-flex; align-items: center; min-height: 40px; }
</style>
