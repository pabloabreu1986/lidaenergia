---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import { SITE, telHref } from '../data/site';
---
<Base title="Gracias | LIDA Energía" description="Gracias por contactar con LIDA Energía, instaladores de placas solares en Madrid." noindex>
  <section class="section">
    <div class="wrap simple">
      <p class="eyebrow">Gracias</p>
      <h1>Gracias por contactar con nosotros.</h1>
      <p class="subtitle">Te respondemos en horario laboral. Si es urgente, llámanos ahora.</p>
      <div class="simple__btns">
        <Button href={telHref} icon="phone" ubicacion="gracias">Llamar al {SITE.phoneDisplay}</Button>
        <Button href="/" variant="link">Volver al inicio</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .simple h1 { max-width: 16ch; }
  .simple__btns { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; margin-top: 2rem; }
</style>
