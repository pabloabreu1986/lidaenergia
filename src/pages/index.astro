---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Reviews from '../components/Reviews.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { SITE, telHref } from '../data/site';

import hero from '../assets/obras/placas-tejado-teja.jpg';
import vivienda from '../assets/obras/tejado-placas-vivienda.jpg';
import nave from '../assets/obras/placas-cubierta-nave.jpg';
import baterias from '../assets/obras/inversores-baterias.jpg';
import cargador from '../assets/obras/cargador-coche-garaje.jpg';
import tecnico from '../assets/obras/tecnico-tejado-seguridad.jpg';

const fases = [
  {
    n: '01',
    title: 'Estudiamos tu caso',
    steps: [
      ['Primera llamada', 'Nos cuentas qué quieres, dónde está la vivienda y cuánto pagas de luz. Te orientamos desde el primer momento.'],
      ['Visita técnica', 'Vemos el tejado, la orientación, las sombras y el cuadro eléctrico para que el presupuesto sea real.'],
    ],
  },
  {
    n: '02',
    title: 'Preparamos la instalación',
    steps: [
      ['Presupuesto cerrado', 'Cuántos paneles necesitas, si te conviene batería y qué ahorro puedes esperar.'],
      ['Permisos', 'Licencia o comunicación al ayuntamiento y documentación técnica: nos ocupamos nosotros.'],
    ],
  },
  {
    n: '03',
    title: 'Lo ponemos en marcha',
    steps: [
      ['Instalación', 'Paneles, inversor y, si los hay, batería y cargador, con todas las medidas de seguridad.'],
      ['Legalización', 'Registro de autoconsumo y compensación de excedentes para que empieces a ahorrar.'],
    ],
  },
];

const faqs = [
  {
    q: '¿Cuánto cuesta instalar placas solares en Madrid?',
    a: '<p>Depende sobre todo de tu consumo, del número de paneles, de si añades batería y del tipo de tejado. Por eso hacemos una visita antes de dar precio. Llámanos al <a href="tel:+34641495513" data-ubicacion="faq">641 49 55 13</a> y te damos una primera orientación por teléfono.</p>',
  },
  {
    q: '¿Hay ayudas o bonificaciones para poner placas solares en Madrid?',
    a: '<p>Sí. Muchos ayuntamientos de la Comunidad de Madrid bonifican el IBI y el ICIO a las viviendas que instalan autoconsumo; el porcentaje y los años cambian de un municipio a otro. También pueden aplicarse deducciones en el IRPF cuando están en vigor. Te decimos cuáles corresponden a tu caso y te ayudamos con los papeles.</p>',
  },
  {
    q: '¿Necesito batería?',
    a: '<p>No siempre. Si en casa consumís mucho por la tarde y por la noche, una batería suele compensar. Si el consumo es sobre todo de día, quizá no. Lo vemos con tus facturas antes de recomendarte nada.</p>',
  },
  {
    q: '¿Cuánto tarda todo el proceso?',
    a: '<p>El montaje en una vivienda suele hacerse en pocos días. Lo que más tiempo lleva son los permisos del ayuntamiento y la legalización, que dependen de cada administración. Te damos el calendario por escrito con el presupuesto.</p>',
  },
  {
    q: '¿Trabajáis fuera de Madrid capital?',
    a: '<p>Sí, trabajamos en Madrid y en la Comunidad de Madrid. Llámanos y te confirmamos si llegamos a tu municipio.</p>',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
};
const webSite = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: `${SITE.url}/`, inLanguage: 'es-ES' };
---
<Base
  title="Instalación de Placas Solares en Madrid | LIDA Energía"
  description="Instaladores de placas solares en Madrid con trato directo y sin comerciales. Baterías, cargadores y legalización. 5,0★ en Google. Llama al 641 49 55 13."
  schema={[webSite, faqSchema]}
  ogImage={hero}
>
  <section class="hero" data-hero>
    <div class="wrap hero__grid">
      <div class="hero__text">
        <h1 class="display hero__h1"><span class="eyebrow">Instalación de placas solares en Madrid</span> <span class="hero__slogan">Tu tejado puede darte más.</span></h1>
        <p class="subtitle">Instalamos placas solares y baterías en tu casa o tu empresa. Hablas directamente con el equipo que estudia tu caso y realiza la instalación.</p>
        <div class="hero__actions">
          <Button href={telHref} size="lg" icon="phone" ubicacion="hero">Hablar de mi instalación</Button>
          <Button href="#presupuesto" size="lg" variant="link">Pedir presupuesto</Button>
        </div>
        <a class="hero__proof" href={SITE.googleMaps} rel="noopener" target="_blank">
          <span class="hero__stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" />)}</span>
          <span><strong>{SITE.rating}</strong> en Google · {SITE.reviewCount} reseñas</span>
        </a>
      </div>
      <figure class="hero__media">
        <Image src={hero} alt="Placas solares instaladas por LIDA Energía sobre un tejado de teja, con la sierra al fondo" widths={[400, 640, 800, 1100]} sizes="(min-width: 64rem) 40vw, 100vw" loading="eager" fetchpriority="high" quality={58} />
      </figure>
    </div>
  </section>

  <section class="section surface-white" id="soluciones" aria-labelledby="sol-h">
    <div class="wrap">
      <SectionHeading eyebrow="Soluciones" title="Placas solares para tu casa o tu empresa." description="Paneles, baterías y recarga del coche eléctrico, según lo que necesitas." id="sol-h" />
      <div class="sol">
        <a class="sol__main" href="/instalacion-placas-solares-madrid/">
          <Image src={vivienda} alt="Paneles solares instalados en el tejado de una vivienda unifamiliar" widths={[480, 720, 960]} sizes="(min-width: 64rem) 45vw, 100vw" quality={70} />
          <div class="sol__body">
            <h3>Placas solares para tu casa</h3>
            <span class="sol__txt">Instalación de placas solares en Madrid para chalets, adosados y comunidades de vecinos, diseñada con tu consumo real.</span>
            <span class="sol__more">Ver instalación para viviendas</span>
          </div>
        </a>
        <a class="sol__second" href="/placas-solares-empresas/">
          <Image src={nave} alt="Placas solares en la cubierta metálica de una nave" widths={[480, 720, 960]} sizes="(min-width: 64rem) 40vw, 100vw" quality={70} />
          <div class="sol__body">
            <h3>Placas solares para empresas</h3>
            <span class="sol__txt">Naves, oficinas y comercios: consumen de día, cuando más producen las placas.</span>
            <span class="sol__more">Ver soluciones para empresas</span>
          </div>
        </a>
        <ul class="sol__minor">
          <li>
            <a href="/instalacion-placas-solares-madrid/#baterias">
              <Image src={baterias} alt="Inversores y baterías solares en un cuarto técnico" widths={[200, 400]} sizes="7rem" quality={70} />
              <div><h3>Baterías solares</h3><span class="sol__txt">Guarda la energía del mediodía para la noche.</span></div>
            </a>
          </li>
          <li>
            <a href="/cargadores-coche-electrico/">
              <Image src={cargador} alt="Cargador de coche eléctrico en la pared de un garaje" widths={[200, 400]} sizes="7rem" quality={70} />
              <div><h3>Cargadores de coche eléctrico</h3><span class="sol__txt">Carga en casa, también con tus placas.</span></div>
            </a>
          </li>
        </ul>
      </div>
      <a class="sol__row" href="/mantenimiento-placas-solares/">
        <span><strong>¿Ya tienes placas?</strong> Mantenimiento y revisión de instalaciones solares, aunque no las hayamos montado nosotros.</span>
        <span class="sol__more">Ver mantenimiento</span>
      </a>
    </div>
  </section>

  <section class="section" id="proceso" aria-labelledby="proc-h">
    <div class="wrap">
      <SectionHeading eyebrow="De la primera llamada a la puesta en marcha" title="Así es la instalación de tus paneles solares." description="Sabes qué viene después: estudiamos tu caso, preparamos la instalación y nos ocupamos de los trámites." id="proc-h" />
      <ol class="fases">
        {fases.map((f) => (
          <li class="fase">
            <span class="fase__n" aria-hidden="true">{f.n}</span>
            <h3>{f.title}</h3>
            <dl>
              {f.steps.map(([t, d]) => (<div><dt>{t}</dt><dd>{d}</dd></div>))}
            </dl>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section surface-white" aria-labelledby="trato-h">
    <div class="wrap trato">
      <figure class="trato__media">
        <Image src={tecnico} alt="Técnico de LIDA Energía con arnés de seguridad trabajando en un tejado" widths={[480, 720, 960, 1200]} sizes="(min-width: 64rem) 50vw, 100vw" quality={72} />
      </figure>
      <div class="trato__text">
        <SectionHeading eyebrow="Trato directo" title="Habla con quien va a instalarlo." description="David y su equipo estudian tu consumo y tu tejado para proponerte una instalación a medida." id="trato-h" />
        <div class="trato__args">
          <div><h3>Sin intermediarios</h3><p>Sin comerciales que prometen y desaparecen: desde la primera llamada hablas con quien hace el trabajo.</p></div>
          <div><h3>Del permiso a la puesta en marcha</h3><p>Licencias, legalización, compensación de excedentes y ayudas: el papeleo es cosa nuestra.</p></div>
          <div><h3>Seguridad en cubierta</h3><p>Trabajamos en tejados con equipos de protección y protocolos de seguridad.</p></div>
        </div>
        <Button href="/sobre-nosotros/" variant="link">Conoce quiénes somos</Button>
      </div>
    </div>
  </section>

  <Reviews />

  <FaqSection items={faqs} id="faq-inicio" title="Preguntas sobre placas solares en Madrid." />

  <CtaBand ubicacion="cierre-portada" id="presupuesto" title="Pide presupuesto para tus paneles solares." />
</Base>

<style>
  /* Hero */
  .hero { padding-block: clamp(2.25rem, 1rem + 5vw, 6.5rem) clamp(3rem, 2rem + 5vw, 7rem); }
  .hero__grid { display: grid; gap: clamp(2rem, 4vw, 4.5rem); align-items: end; }
  .hero__h1 .eyebrow { line-height: 1.4; font-stretch: 100%; }
  .hero__slogan { display: block; max-width: 9.5ch; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.75rem; margin: 2.25rem 0 1.5rem; }
  .hero__proof { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; color: var(--pizarra-2); text-decoration: none; font-size: 0.95rem; }
  .hero__proof:hover span:last-child { text-decoration: underline; }
  .hero__stars { display: flex; color: var(--sol-tinta); }
  .hero__stars :global(svg) { width: 1.1rem; height: 1.1rem; }
  .hero__media { margin: 0; }
  .hero__media :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--r-media); }
  @media (min-width: 64rem) {
    .hero__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .hero__media :global(img) { aspect-ratio: 4 / 5; }
  }

  /* Soluciones */
  .sol { display: grid; gap: 1.25rem; margin-top: clamp(2.5rem, 5vw, 4.5rem); }
  .sol a { color: var(--pizarra); text-decoration: none; }
  .sol__main, .sol__second { display: grid; gap: 1.25rem; align-content: start; }
  .sol__main :global(img), .sol__second :global(img) { width: 100%; object-fit: cover; border-radius: var(--r-media); }
  .sol__main :global(img) { aspect-ratio: 4 / 3; }
  .sol__second :global(img) { aspect-ratio: 16 / 10; }
  .sol__body { display: grid; gap: 0.5rem; }
  .sol__txt { color: var(--pizarra-2); max-width: 46ch; }
  .sol__more { font-weight: 600; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.25em; }
  .sol a:hover .sol__more, .sol a:hover h3 { text-decoration-thickness: 2px; }
  .sol a:hover h3 { text-decoration: underline; text-underline-offset: 0.15em; }
  .sol__minor { list-style: none; margin: 0.5rem 0 0; padding: 0; display: grid; border-top: 1px solid var(--linea); }
  .sol__minor li { margin: 0; border-bottom: 1px solid var(--linea); }
  .sol__minor a { display: grid; grid-template-columns: 5.5rem 1fr; gap: 1rem; align-items: center; padding: 1rem 0; }
  .sol__minor :global(img) { width: 5.5rem; height: 5.5rem; object-fit: cover; border-radius: 12px; }
  .sol__minor h3 { font-size: 1.2rem; margin-bottom: 0.2rem; }
  .sol__row {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem 2rem;
    margin-top: 2rem; padding: 1.4rem 1.5rem; border-radius: var(--r-media); background: var(--papel);
    color: var(--pizarra); text-decoration: none;
  }
  .sol__row:hover .sol__more { text-decoration-thickness: 2px; }
  @media (min-width: 64rem) {
    .sol { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); grid-template-rows: auto auto; gap: 2.5rem 3rem; }
    .sol__main { grid-row: 1 / span 2; }
    .sol__main :global(img) { aspect-ratio: 5 / 6; }
    .sol__minor { margin-top: 0; align-self: end; }
  }

  /* Proceso */
  .fases { list-style: none; padding: 0; margin: clamp(2.5rem, 5vw, 4.5rem) 0 0; display: grid; gap: 2.5rem; }
  .fase { margin: 0; padding-top: 1.5rem; border-top: 2px solid var(--pizarra); }
  .fase__n { display: block; font-size: clamp(2.5rem, 2rem + 2vw, 4rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1; color: var(--pizarra-3); margin-bottom: 1rem; font-variant-numeric: tabular-nums; }
  .fase h3 { margin-bottom: 1.25rem; }
  .fase dl { margin: 0; display: grid; gap: 1rem; }
  .fase dt { font-weight: 640; }
  .fase dd { margin: 0.2rem 0 0; color: var(--pizarra-2); }
  @media (min-width: 64rem) { .fases { grid-template-columns: repeat(3, 1fr); gap: 3rem; } }

  /* Trato directo */
  .trato { display: grid; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .trato__media { margin: 0; }
  .trato__media :global(img) { width: 100%; aspect-ratio: 4 / 3.2; object-fit: cover; border-radius: var(--r-media); }
  .trato__args { display: grid; gap: 1.5rem; margin: 2.5rem 0 1.5rem; }
  .trato__args h3 { font-size: 1.2rem; margin-bottom: 0.35rem; }
  .trato__args p { margin: 0; color: var(--pizarra-2); }
  @media (min-width: 64rem) { .trato { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); } .trato__media :global(img) { aspect-ratio: 4 / 4.6; } }
</style>
