---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import FaqSection from '../components/FaqSection.astro';
import Reviews from '../components/Reviews.astro';
import { SITE, telHref, waHref } from '../data/site';

const faqs = [
  {
    q: '¿El presupuesto tiene algún compromiso?',
    a: '<p>No. Te damos el presupuesto y decides con calma. Si tienes otras ofertas, te ayudamos a compararlas.</p>',
  },
  {
    q: '¿Qué necesito para pedir presupuesto?',
    a: '<p>Una factura de luz reciente (mejor si es de invierno y de verano) y saber dónde quieres poner las placas. Con eso ya podemos darte una primera orientación.</p>',
  },
  {
    q: '¿Cómo os contacto si no puedo llamar ahora?',
    a: '<p>Escríbenos por WhatsApp al 641 49 55 13 o un email a info@lidaenergia.com con tu nombre, tu municipio y lo que necesitas, y te llamamos en horario laboral.</p>',
  },
];
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
}];
const pasos = [
  ['Nos llamas o nos escribes', 'Con una factura de luz a mano te damos una orientación de potencia y precio.'],
  ['Visita técnica', 'Vemos el tejado, las sombras y el cuadro eléctrico.'],
  ['Presupuesto por escrito', 'Número de paneles, inversor, batería si compensa, trámites incluidos, plazos y ahorro estimado.'],
];
---
<Base
  title="Presupuesto de Placas y Paneles Solares en Madrid | LIDA"
  description="Pide presupuesto sin compromiso para instalar paneles solares en Madrid. Estudiamos tu consumo y tu tejado y te damos un precio cerrado. Llama al 641 49 55 13."
  breadcrumbs={[{ name: 'Presupuesto de placas solares', href: '/presupuesto-placas-solares/' }]}
  schema={schema}
>
  <section class="pp" id="presupuesto">
    <div class="wrap pp__grid">
      <div>
        <p class="eyebrow">Presupuesto sin compromiso</p>
        <h1>Presupuesto de placas solares en Madrid</h1>
        <p class="subtitle">¿Quieres presupuesto para instalar paneles solares? Llámanos o escríbenos por WhatsApp. Hablas directamente con quien va a hacer la instalación.</p>
        <div class="pp__btns">
          <Button href={telHref} size="lg" icon="phone" ubicacion="presupuesto">Llamar al {SITE.phoneDisplay}</Button>
          <Button href={waHref()} size="lg" variant="outline" icon="whatsapp" ubicacion="presupuesto" external>Escribir por WhatsApp</Button>
        </div>
        <p class="pp__alt">También por email: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
      <div class="pp__next">
        <h2>Cómo es el presupuesto de tus paneles solares</h2>
        <ol>
          {pasos.map(([t, d], i) => (
            <li><span class="pp__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><div><h3>{t}</h3><p>{d}</p></div></li>
          ))}
        </ol>
      </div>
    </div>
  </section>
  <FaqSection items={faqs} id="faq-presupuesto" surface="surface-white" title="Antes de pedir presupuesto." description="Compromiso, qué tener a mano y otras formas de contactar." />
  <Reviews />
</Base>

<style>
  .pp { padding-block: clamp(2.5rem, 1.5rem + 4vw, 6rem) var(--section); }
  .pp__grid { display: grid; gap: clamp(2.5rem, 5vw, 5rem); align-items: start; }
  .pp h1 { max-width: 14ch; }
  .pp__btns { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 2rem 0 1rem; }
  .pp__alt { color: var(--pizarra-2); }
  .pp__next { background: var(--blanco); border: 1px solid var(--linea); border-radius: var(--r-media); padding: clamp(1.5rem, 3vw, 2.5rem); }
  .pp__next h2 { font-size: var(--fs-h3); margin-bottom: 1.5rem; }
  .pp__next ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.5rem; }
  .pp__next li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.75rem; margin: 0; }
  .pp__n { font-weight: 600; color: var(--pizarra-3); font-variant-numeric: tabular-nums; padding-top: 0.15rem; }
  .pp__next h3 { font-size: 1.1rem; margin-bottom: 0.25rem; }
  .pp__next p { margin: 0; color: var(--pizarra-2); }
  @media (max-width: 30rem) { .pp__btns :global(.btn) { width: 100%; } }
  @media (min-width: 64rem) { .pp__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } }
</style>
